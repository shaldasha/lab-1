from math import *
def f(x): return 1-x+sin(x)-log(1+x) # функция 14 вариант 
l = 0 # левая граница отрезка
r = 2 # правая граница отрезка
print(f(l),f(r)) # функция убывает на данном отрезке

# Метод половинного деления
def method_1(l,r):
  while r-l>0.0001: # пока разница границ значимая
    x = (l+r)/2 # точка в центре рассматримаего отрезка
    if f(x)>0: # если значение функции от центрального значения больше 0
      l=x # двигаем левую границу, т.к. точка, в которой значение функции равно 0, из-за монотонного убывания находится правее центра
    else:
      r=x
  print((r+l)/2) # точка в центре рассматримаего отрезка

# Метод хорд
def method_2(l,r):
  while r-l>0.0001: # пока разница границ значимая
    x = l - (f(l)*(r-l))/(f(r)-f(l)) # точка на пересечении прямой через концы отрезков и прямой Ox
    if f(x)>0: # если значение функции от x больше 0
      l=x # двигаем левую границу, т.к. точка, в которой значение функции равно 0, из-за монотонного убывания находится правее центра
    else:
      r=x
  print((r+l)/2) # точка в центре рассматримаего отрезка

method_1(l,r)
method_2(l,r)

